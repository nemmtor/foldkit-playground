{
  "name": "foldkieet",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "dead-code": "knip",
    "generate:dependencies-graph": "npx depcruise src --include-only \"^src\" --output-type archi | dot -T svg > dependency-graph.svg",
    "dependencies": "depcruise src",
    "architecture": "steiger ./src",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm format && pnpm lint && pnpm test && pnpm dead-code && pnpm dependencies && pnpm architecture"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-beta.59",
    "@tailwindcss/vite": "^4.1.18",
    "clsx": "^2.1.1",
    "effect": "4.0.0-beta.59",
    "foldkit": "0.82.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.5.7",
    "@foldkit/vite-plugin": "^0.4.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@vitest/eslint-plugin": "^1.6.16",
    "dependency-cruiser": "^17.4.0",
    "dot": "^1.1.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "happy-dom": "^20.9.0",
    "knip": "^6.11.0",
    "prettier": "^3.8.1",
    "steiger": "^0.5.11",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.33.2"
}
